# MySQL connection
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=Hospital
MYSQLUSER=root
MYSQLPASSWORD=your_db_password

# Fallback password variable (used if MYSQLPASSWORD is not set)
# DB_PASSWORD=your_db_password

# HTTP port (Railway injects PORT automatically)
PORT=8080

# JWT signing secret — use a long random value in production
JWT_SECRET=hospital-management-saas-secret-key-2026-very-long-secure

# Comma-separated list of allowed CORS origins
# e.g. https://hospital-management-system-eta-beige.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
